{
  "name": "frwd",
  "version": "0.0.0",
  "private": true,
  "description": "FRWD - Flowing Rich Web Document. An open, portable, AI-native document format built on semantic HTML.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Entract/FRWD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Entract/FRWD.git"
  },
  "bugs": {
    "url": "https://github.com/Entract/FRWD/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc --build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:browser": "pnpm build && playwright test --pass-with-no-tests",
    "fixtures:canonicalize": "pnpm build && node scripts/canonicalize-fixtures.mjs",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@frwd/format": "workspace:*",
    "@frwd/operations": "workspace:*",
    "@frwd/publisher": "workspace:*",
    "@frwd/runtime": "workspace:*",
    "@frwd/sanitize": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
