  "language": "en",
  "description": "Every rich component the 0.1 runtime knows about, each with a fallback that reads correctly when nothing runs."
}
</script>
<script id="quarterly-revenue" type="application/frwd-dataset+json">
{
  "columns": ["quarter", "revenue"],
  "rows": [["Q1", 10], ["Q2", 13]]
}
</script>
<style id="frwd-document-style">
:root { color-scheme: light dark; --measure: 34rem; }
body { margin: 0; font: 400 1rem/1.6 ui-serif, Georgia, serif; }
main { max-width: var(--measure); margin: 3rem auto; padding: 0 1.25rem; }
frwd-callout { display: block; }
aside { border-left: 3px solid currentColor; padding-left: 1rem; }
frwd-disclosure { display: block; margin: 1.5rem 0; }
