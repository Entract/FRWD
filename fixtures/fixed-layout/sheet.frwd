<title>Sheet-geometry document</title>
<script id="frwd-manifest" type="application/frwd+json">
{
  "format": "frwd",
  "version": "0.1",
  "documentId": "f4e3d2c1-0b9a-4867-8564-3d2c1b0a9f87",
