<style id="frwd-document-style">
:root {
  color-scheme: light dark;

  --ink: #14181f;
  --ink-quiet: #5b6472;
  --paper: #fdfcfa;
  --rule: #e2ded7;
  --accent: #1f5f4b;
  --accent-quiet: #e8f0ec;
  --warn: #8a4b1f;

  --measure: 38rem;
  --gutter: clamp(1.25rem, 4vw, 3rem);
  --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, ui-serif, serif;
  --sans: ui-sans-serif, "Segoe UI", Inter, system-ui, -apple-system, sans-serif;
  --mono: ui-monospace, "SF Mono", "Cascadia Mono", Menlo, monospace;
}

@media (prefers-color-scheme: dark) {
  :root {
    --ink: #e9eaee;
    --ink-quiet: #9aa3b2;
    --paper: #101319;
    --rule: #262c36;
    --accent: #6fd3ae;
    --accent-quiet: #16241f;
    --warn: #e0a06a;
  }
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font: 400 1.0625rem/1.65 var(--serif);
  font-feature-settings: "kern", "liga", "onum";
  text-rendering: optimizeLegibility;
}

main { display: block; }

/* ---- Cover ------------------------------------------------------------- */

.cover {
  padding: clamp(3rem, 12vh, 8rem) var(--gutter) clamp(2.5rem, 8vh, 5rem);
  background:
    radial-gradient(120% 90% at 100% 0%, var(--accent-quiet) 0%, transparent 60%),
    linear-gradient(180deg, var(--accent-quiet) 0%, transparent 85%);
  border-bottom: 1px solid var(--rule);
}

.cover > * { max-width: var(--measure); margin-inline: auto; }

.eyebrow {
  font: 600 0.75rem/1.4 var(--sans);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  margin: 0 0 1.25rem;
}

.cover h1 {
  font: 600 clamp(2.25rem, 6vw, 3.75rem)/1.05 var(--sans);
  letter-spacing: -0.03em;
  margin: 0 0 1rem;
  text-wrap: balance;
}

.standfirst {
  font: 400 clamp(1.125rem, 2.2vw, 1.375rem)/1.5 var(--serif);
  color: var(--ink-quiet);
  margin: 0 0 2rem;
  text-wrap: pretty;
}

.byline {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
  font: 500 0.8125rem/1.4 var(--sans);
  color: var(--ink-quiet);
  border-top: 1px solid var(--rule);
  padding-top: 1rem;
  margin: 0;
}

/* ---- Body grid --------------------------------------------------------- */

.body {
  display: grid;
  grid-template-columns: minmax(0, var(--measure)) minmax(0, 15rem);
  gap: clamp(1.5rem, 4vw, 3.5rem);
  justify-content: center;
  align-items: start;
  padding: clamp(2.5rem, 7vh, 5rem) var(--gutter);
}

.body > .flow { min-width: 0; }
.body > .rail { min-width: 0; }

@media (max-width: 60rem) {
  .body { grid-template-columns: minmax(0, var(--measure)); }
  .body > .rail { max-width: var(--measure); }
}

h2 {
  font: 600 clamp(1.375rem, 2.6vw, 1.75rem)/1.2 var(--sans);
  letter-spacing: -0.02em;
  margin: 3rem 0 0.75rem;
  text-wrap: balance;
}

h2:first-child { margin-top: 0; }

h3 {
  font: 600 1rem/1.3 var(--sans);
  letter-spacing: 0.01em;
  margin: 2rem 0 0.5rem;
}

p { margin: 0 0 1.15rem; text-wrap: pretty; }

.lead { font-size: 1.1875rem; color: var(--ink); }

.lead::first-letter {
  float: left;
  font: 600 3.6rem/0.82 var(--sans);
  padding: 0.1rem 0.5rem 0 0;
  color: var(--accent);
}

a { color: var(--accent); text-underline-offset: 0.15em; }

/* ---- Rail -------------------------------------------------------------- */

.rail { font: 400 0.9375rem/1.55 var(--sans); color: var(--ink-quiet); }
.rail h3 { color: var(--ink); margin-top: 0; }

.metric { border-top: 2px solid var(--accent); padding-top: 0.75rem; margin: 0 0 1.75rem; }
.metric dt { font: 500 0.75rem/1.3 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; }
.metric dd {
  margin: 0.15rem 0 0;
  font: 600 2rem/1.05 var(--sans);
  letter-spacing: -0.02em;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
.metric dd p { font: 400 0.8125rem/1.45 var(--sans); color: var(--ink-quiet); margin: 0.35rem 0 0; letter-spacing: 0; }

/* ---- Figures ----------------------------------------------------------- */

figure { margin: 2rem 0; }

figure.wide {
  width: min(100%, calc(var(--measure) + 8rem));
  margin-inline: calc((100% - min(100%, calc(var(--measure) + 8rem))) / 2);
}

figure svg { display: block; width: 100%; height: auto; }

figcaption {
  font: 400 0.8125rem/1.5 var(--sans);
  color: var(--ink-quiet);
  margin-top: 0.6rem;
  padding-top: 0.6rem;
  border-top: 1px solid var(--rule);
}

/* ---- Table ------------------------------------------------------------- */

.table-scroll { overflow-x: auto; }

table {
  width: 100%;
  border-collapse: collapse;
  font: 400 0.9375rem/1.5 var(--sans);
  font-variant-numeric: tabular-nums;
}

caption {
  text-align: left;
  font: 600 0.8125rem/1.4 var(--sans);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-quiet);
  padding-bottom: 0.6rem;
}

th, td { padding: 0.55rem 0.75rem; border-bottom: 1px solid var(--rule); text-align: right; }
th:first-child, td:first-child { text-align: left; padding-left: 0; }
th { font-weight: 600; color: var(--ink-quiet); }
thead th { border-bottom: 2px solid var(--ink); }
tfoot td { font-weight: 600; border-bottom: none; border-top: 2px solid var(--ink); }

/* ---- Callout and disclosure -------------------------------------------- */

frwd-callout { display: block; margin: 2rem 0; }

.frwd-callout {
  border-left: 3px solid var(--accent);
  background: var(--accent-quiet);
  padding: 1.1rem 1.25rem;
  border-radius: 0 4px 4px 0;
}

.frwd-callout p { margin: 0; font-size: 0.9375rem; }
.frwd-callout p + p { margin-top: 0.6rem; }

frwd-disclosure { display: block; margin: 2rem 0; border-top: 1px solid var(--rule); padding-top: 0.9rem; }

[data-frwd-disclosure-toggle] {
  font: 600 0.875rem/1.3 var(--sans);
  color: var(--accent);
  background: none;
  border: 0;
  padding: 0;
  cursor: pointer;
}

[data-frwd-disclosure-body] { font-size: 0.9375rem; padding-top: 0.75rem; }

/* ---- Print ------------------------------------------------------------- */

@media print {
  :root { --ink: #000; --ink-quiet: #444; --paper: #fff; --rule: #bbb; --accent: #14503f; --accent-quiet: #eef3f0; }

  body { font-size: 10.5pt; line-height: 1.45; }

  .cover { padding: 0 0 1.5rem; background: none; page-break-after: always; break-after: page; }
  .cover h1 { font-size: 30pt; }

  .body { display: block; padding: 0; }
  .rail { margin-top: 2rem; column-count: 2; column-gap: 1.5rem; }

  h2, h3 { break-after: avoid-page; }
  figure, table, frwd-callout { break-inside: avoid; }
  p { orphans: 3; widows: 3; }

  [data-frwd-disclosure-toggle] { display: none; }
}
</style>
</head>
<body>
<main data-frwd-document="">
<article data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000001">

<header data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000002" class="cover">
<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000003" class="eyebrow">Annual Review · 2026</p>
<h1 data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000004">The year we stopped guessing</h1>
<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000005" class="standfirst">Recurring revenue grew 59% while headcount grew 11%. This review explains what changed, what it cost, and which of last year's assumptions turned out to be wrong.</p>
<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000006" class="byline"><span>Northwind Instruments</span> <span>Prepared 9 August 2026</span> <span>18 minute read</span></p>
</header>

<div data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000007" class="body">

<div data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000008" class="flow">

<section data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000009">
<h2 data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000010">What changed</h2>
<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000011" class="lead">Three years of flat revenue ended in the second quarter, and it did not end because of a new product. It ended because we finally measured which customers renewed and asked the ones who did not why they left. The answers were unflattering and useful in roughly equal measure.</p>
<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000012">Instrument calibration — the part of the business we had treated as a support obligation — turned out to be the reason two thirds of our largest accounts stayed. We had been pricing it at cost and staffing it from whoever was free. Once it became a product with its own team and its own service level, renewals stopped being a quarterly negotiation.</p>

<figure data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000013" class="wide">
<frwd-chart data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000014" data-source="revenue-by-quarter" data-type="bar" data-x="quarter" data-y="recurring">
<svg aria-labelledby="chart-title" preserveAspectRatio="xMidYMid meet" role="img" style="color: var(--accent)" viewBox="0 0 720 300"><title id="chart-title">Recurring revenue by quarter, rising from 4.2 to 6.7 million.</title><line stroke="currentColor" stroke-opacity="0.14" x1="44" x2="712" y1="250.0" y2="250.0"></line><text fill="currentColor" fill-opacity="0.55" font-size="12" text-anchor="end" x="34" y="254.0">0</text><line stroke="currentColor" stroke-opacity="0.14" x1="44" x2="712" y1="195.0" y2="195.0"></line><text fill="currentColor" fill-opacity="0.55" font-size="12" text-anchor="end" x="34" y="199.0">2</text><line stroke="currentColor" stroke-opacity="0.14" x1="44" x2="712" y1="140.0" y2="140.0"></line><text fill="currentColor" fill-opacity="0.55" font-size="12" text-anchor="end" x="34" y="144.0">4</text><line stroke="currentColor" stroke-opacity="0.14" x1="44" x2="712" y1="85.0" y2="85.0"></line><text fill="currentColor" fill-opacity="0.55" font-size="12" text-anchor="end" x="34" y="89.0">6</text><line stroke="currentColor" stroke-opacity="0.14" x1="44" x2="712" y1="30.0" y2="30.0"></line><text fill="currentColor" fill-opacity="0.55" font-size="12" text-anchor="end" x="34" y="34.0">8</text><rect fill="currentColor" fill-opacity="0.32" height="115.5" rx="3" width="85.8" x="83.6" y="134.5"></rect><text fill="currentColor" font-size="13" font-weight="600" text-anchor="middle" x="126.5" y="125.5">4.2</text><text fill="currentColor" fill-opacity="0.6" font-size="12" text-anchor="middle" x="126.5" y="272">Q1</text><rect fill="currentColor" fill-opacity="0.32" height="140.3" rx="3" width="85.8" x="248.6" y="109.8"></rect><text fill="currentColor" font-size="13" font-weight="600" text-anchor="middle" x="291.5" y="100.8">5.1</text><text fill="currentColor" fill-opacity="0.6" font-size="12" text-anchor="middle" x="291.5" y="272">Q2</text><rect fill="currentColor" fill-opacity="0.32" height="132.0" rx="3" width="85.8" x="413.6" y="118.0"></rect><text fill="currentColor" font-size="13" font-weight="600" text-anchor="middle" x="456.5" y="109.0">4.8</text><text fill="currentColor" fill-opacity="0.6" font-size="12" text-anchor="middle" x="456.5" y="272">Q3</text><rect fill="currentColor" fill-opacity="1" height="184.3" rx="3" width="85.8" x="578.6" y="65.8"></rect><text fill="currentColor" font-size="13" font-weight="600" text-anchor="middle" x="621.5" y="56.8">6.7</text><text fill="currentColor" fill-opacity="0.6" font-size="12" text-anchor="middle" x="621.5" y="272">Q4</text><line stroke="currentColor" stroke-opacity="0.45" x1="44" x2="712" y1="250" y2="250"></line></svg>
</frwd-chart>
<figcaption data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000015"><strong>Recurring revenue by quarter</strong>, in millions. The fourth quarter includes the first full period of calibration contracts sold as a standalone service. The chart is a static figure with a described fallback; the trusted runtime may hydrate it, and the document reads identically if it never does.</figcaption>
</figure>

<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000016">The second change was slower to see. Support tickets fell 31% year on year, but not because the instruments got better — they did not, materially. They fell because the calibration team was catching drift before customers noticed it. That is a cost centre turning into a retention mechanism, and it took us three years to spot.</p>
</section>

<section data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000017">
<h2 data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000018">What it cost</h2>
<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000019">Standing up the calibration team consumed most of the year's discretionary budget and all of its patience. We hired six engineers, lost two of them, and rebuilt the scheduling system twice.</p>

<div data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000020" class="table-scroll">
<table data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000021">
<caption data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000022">Operating summary, £m</caption>
<thead>
<tr><th scope="col">Line</th><th scope="col">2025</th><th scope="col">2026</th><th scope="col">Change</th></tr>
</thead>
<tbody>
<tr><th scope="row">Recurring revenue</th><td>13.1</td><td>20.8</td><td>+59%</td></tr>
<tr><th scope="row">Services revenue</th><td>5.4</td><td>4.7</td><td>−13%</td></tr>
<tr><th scope="row">Cost of delivery</th><td>8.2</td><td>11.9</td><td>+45%</td></tr>
<tr><th scope="row">Headcount</th><td>96</td><td>107</td><td>+11%</td></tr>
</tbody>
<tfoot>
<tr><td>Operating margin</td><td>9.4%</td><td>14.1%</td><td>+4.7pp</td></tr>
</tfoot>
</table>
</div>

<frwd-callout data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000023">
<aside data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000024" class="frwd-callout">
<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000025"><strong>Services revenue fell on purpose.</strong> We stopped taking bespoke integration work below £40k. It was 13% of revenue and roughly 40% of delivery escalations.</p>
<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000026">The two are not unrelated, and next year's plan assumes they stay that way.</p>
</aside>
</frwd-callout>
</section>

<section data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000027">
<h2 data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000028">What we got wrong</h2>
<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000029">Last year's review predicted that the instrument refresh would carry the year. It did not. Units shipped came in 8% under plan, and the accounts that did upgrade were, almost without exception, accounts already on a calibration contract. The hardware followed the service, not the other way round.</p>
<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000030">We also assumed the calibration team could be regional. It cannot: drift patterns are instrument-specific, not climate-specific, and the scheduling gains came from pooling expertise rather than from proximity.</p>

<frwd-disclosure data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000031" data-frwd-expanded="false">
<button aria-expanded="false" data-frwd-disclosure-toggle="" type="button">Method and definitions</button>
<div data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000032" data-frwd-disclosure-body="">
<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000033">Recurring revenue is contracted revenue with a term of twelve months or longer, recognised monthly. Services revenue excludes calibration from the second quarter onward, when it moved into the recurring line; the 2025 comparative has been restated on the same basis.</p>
<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000034">Support ticket counts exclude tickets opened by our own engineers during scheduled calibration visits.</p>
</div>
</frwd-disclosure>
</section>

</div>

<aside data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000035" class="rail">
<h3 data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000036">The year in four numbers</h3>

<dl data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000037" class="metric">
<dt data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000038">Recurring revenue</dt>
<dd data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000039">£20.8m<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000040">Up 59%. Fourth quarter alone was £6.7m.</p></dd>
</dl>

<dl data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000041" class="metric">
<dt data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000042">Net retention</dt>
<dd data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000043">118%<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000044">First year above 100% since 2022.</p></dd>
</dl>

<dl data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000045" class="metric">
<dt data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000046">Support tickets</dt>
<dd data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000047">−31%<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000048">Against 11% more instruments in the field.</p></dd>
</dl>

<dl data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000049" class="metric">
<dt data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000050">Operating margin</dt>
<dd data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000051">14.1%<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000052">After absorbing the calibration build-out.</p></dd>
</dl>

<h3 data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000053">On the record</h3>
<p data-frwd-id="9b3f2c10-5a41-4d8e-8f21-000000000054">Figures are unaudited and restated where noted. The underlying dataset travels inside this file and can be read without our software.</p>
</aside>

</div>
</article>
</main>

</body></html>